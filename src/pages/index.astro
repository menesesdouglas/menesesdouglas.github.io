---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Stack from "../components/sections/Stack.astro";
import Projetos from "../components/sections/Projetos.astro";
import Sobre from "../components/sections/Sobre.astro";
import Experiencia from "../components/sections/Experiencia.astro";
import Competencias from "../components/sections/Competencias.astro";
import Contato from "../components/sections/Contato.astro";
import { site } from "../data/site";
---
<Layout
  title={`${site.nome} — ${site.titulo}`}
  description={site.metaDescription}
>
  <div class="container">
    <Hero />
    <Stack />
    <Projetos />
    <Sobre />
    <Experiencia />
    <Competencias />
    <Contato />
  </div>
</Layout>