---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Servicos from '../components/Servicos.astro';
import Portfolio from '../components/Portfolio.astro';
import Sobre from '../components/Sobre.astro';
import FAQ from '../components/FAQ.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const title = 'Sites e softwares sob medida — Engenheiro de Computação | Farol Labs';
const description =
  'Landing pages, sites e softwares customizados para negócios locais e pequenas empresas. Código próprio, sem template. Orçamento fechado antes de começar.';
---

<BaseLayout title={title} description={description}>
  <Header />

  <main>
    <Hero />
    <Servicos />
    <Portfolio />
    <Sobre />
    <FAQ />
    <CTAFinal />
  </main>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>