---
// Componente de apresentação — a lógica está no <script> abaixo,
// que o Astro empacota como módulo deferido (roda após o DOM existir).
---
<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Alternar tema claro/escuro"
  title="Alternar tema"
>
  <!-- Ícone Lua (visível no tema claro) -->
  <svg
    class="icon icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>

  <!-- Ícone Sol (visível no tema escuro) -->
  <svg
    class="icon icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    color: var(--color-text-soft);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }
  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .icon {
    width: 18px;
    height: 18px;
  }

  /* Padrão (dark, ou JS desabilitado): mostra sol */
  .icon-moon { display: none; }
  .icon-sun  { display: block; }

  /* No tema claro: mostra lua */
  :global([data-theme="light"]) .icon-moon { display: block; }
  :global([data-theme="light"]) .icon-sun  { display: none; }
</style>

<script>
  const btn = document.getElementById("theme-toggle");

  if (btn) {
    btn.addEventListener("click", () => {
      const current = document.documentElement.getAttribute("data-theme") || "dark";
      const next = current === "dark" ? "light" : "dark";

      document.documentElement.setAttribute("data-theme", next);

      try {
        localStorage.setItem("theme", next);
      } catch {
        // localStorage indisponível (modo privado etc.) → ignora silenciosamente
      }

      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) {
        meta.setAttribute("content", next === "light" ? "#f8fafc" : "#0b1220");
      }
    });
  }
</script>