---
interface Props {
  url: string;
  /** Quando você tiver os prints reais, passe o import da imagem aqui. */
  src?: ImageMetadata;
  alt?: string;
  variant?: 'desktop' | 'phone';
  class?: string;
}

const { url, src, alt = '', variant = 'desktop', class: className } = Astro.props;
const host = url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<div class:list={['mockup', `mockup--${variant}`, className]}>
  {variant === 'desktop' && (
    <div class="mockup__chrome">
      <span class="mockup__dot"></span>
      <span class="mockup__dot"></span>
      <span class="mockup__dot"></span>
      <span class="mockup__host">{host}</span>
    </div>
  )}

  <div class="mockup__screen">
    {src && (
      <img
        src={src.src}
        alt={alt}
        width={src.width}
        height={src.height}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-top"
      />
    )}

    {!src && (
      <div class="wf" aria-hidden="true">
        <div class="wf__top">
          <span class="wf__brand"></span>
          <span class="wf__nav"><i></i><i></i><i></i></span>
        </div>
        <div class="wf__hero">
          <span class="wf__title"></span>
          <span class="wf__title wf__title--short"></span>
          <span class="wf__text"></span>
          <span class="wf__text wf__text--short"></span>
          <span class="wf__cta"></span>
        </div>
        <div class="wf__grid"><span></span><span></span><span></span></div>
      </div>
    )}
  </div>
</div>

<style>
  .mockup {
    position: relative;
    border: 1px solid var(--color-line);
    background-color: #fff;
    border-radius: 5px;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgba(31, 29, 27, 0.04),
      0 28px 56px -36px rgba(31, 29, 27, 0.3);
  }

  .mockup__chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 13px;
    border-bottom: 1px solid var(--color-line);
    background-color: var(--color-paper-deep);
  }

  .mockup__dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background-color: #d9d2c9;
  }

  .mockup__host {
    margin-left: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.03em;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mockup__screen {
    aspect-ratio: 16 / 10;
    background-color: #fff;
    overflow: hidden;
  }

  /* ---------- variante phone ---------- */
  .mockup--phone {
    border-radius: 18px;
    padding: 4px;
    background-color: #fff;
  }
  .mockup--phone .mockup__screen {
    aspect-ratio: 9 / 17;
    border-radius: 14px;
    overflow: hidden;
  }
  .mockup--phone .wf {
    padding: 14px 12px;
    gap: 10px;
  }
  .mockup--phone .wf__title { height: 9px; }
  .mockup--phone .wf__text { height: 4px; }
  .mockup--phone .wf__cta { height: 16px; width: 100%; }
  .mockup--phone .wf__grid { grid-template-columns: 1fr; }
  .mockup--phone .wf__grid span { height: 26px; }
  .mockup--phone .wf__nav { display: none; }

  /* ---------- wireframe placeholder ---------- */
  .wf {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    height: 100%;
  }

  .wf__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wf__brand {
    width: 52px;
    height: 8px;
    border-radius: 2px;
    background-color: var(--color-ink);
    opacity: 0.85;
  }
  .wf__nav { display: flex; gap: 6px; }
  .wf__nav i {
    display: block;
    width: 22px;
    height: 6px;
    border-radius: 2px;
    background-color: var(--color-line);
  }

  .wf__hero {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 12px;
  }
  .wf__title {
    height: 14px;
    width: 78%;
    border-radius: 2px;
    background-color: var(--color-ink);
    opacity: 0.9;
  }
  .wf__title--short { width: 46%; }
  .wf__text {
    height: 6px;
    width: 62%;
    border-radius: 2px;
    background-color: var(--color-line);
  }
  .wf__text--short { width: 38%; }
  .wf__cta {
    margin-top: 10px;
    width: 92px;
    height: 22px;
    border-radius: 2px;
    background-color: var(--color-accent);
  }

  .wf__grid {
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .wf__grid span {
    height: 48px;
    border-radius: 3px;
    background-color: var(--color-accent-soft);
    border: 1px solid var(--color-line);
  }
</style>