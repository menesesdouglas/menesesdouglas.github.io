---
import SectionHeading from './SectionHeading.astro';
import { servicos } from '../data/servicos';
---

<section id="servicos">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <SectionHeading
      numero="01"
      titulo="Serviços"
      descricao="Três formas de resolver. Cada uma parte de um problema diferente."
    />

    <div class="mt-14 grid border-t border-line md:grid-cols-3">
      {
        servicos.map((servico, i) => (
          <article
            class="border-b border-line py-9 last:border-b-0 md:border-b-0 md:border-l md:border-line md:py-0 md:pl-9 md:first:border-l-0 md:first:pl-0"
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            <h3 class="text-xl md:text-[1.375rem]">{servico.titulo}</h3>

            <p class="mt-4 text-[15px] leading-relaxed text-muted">
              {servico.descricao}
            </p>

            <ul class="mt-7 space-y-3 border-t border-line pt-7">
              {servico.entregaveis.map((item) => (
                <li class="flex gap-3 text-[14px] leading-snug">
                  <span class="mt-[9px] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>