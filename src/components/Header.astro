---
import MobileMenu from '../islands/MobileMenu.tsx';
import { site, whatsappUrl } from '../data/site';

const links = [
  { href: '#servicos', label: 'Serviços' },
  { href: '#portfolio', label: 'Portfólio' },
  { href: '#sobre', label: 'Sobre' },
  { href: '#faq', label: 'FAQ' },
];
---

<header data-header class="fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6">
    <a href="#hero" class="wordmark" aria-label="Início">
      {site.nome}
    </a>

    <nav class="hidden items-center gap-9 md:flex" aria-label="Navegação principal">
      {links.map((link) => (
        <a class="navlink" href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        class="btn btn-primary hidden h-9 px-4 text-xs md:inline-flex"
      >
        Falar no WhatsApp
      </a>
      <MobileMenu client:load whatsapp={whatsappUrl} />
    </div>
  </div>
</header>