---
import SectionHeading from './SectionHeading.astro';
import Mockup from './Mockup.astro';
import { projetos } from '../data/projetos';
---

<section id="portfolio" class="border-y border-line bg-paper-deep/60">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <SectionHeading
      numero="02"
      titulo="Portfólio"
      descricao="Quatro projetos publicados, cada um construído do zero."
    />

    <div class="mt-16 space-y-24 md:space-y-32">
      {
        projetos.map((projeto, i) => {
          const invertido = i % 2 === 1;

          return (
            <article class="grid items-center gap-10 md:grid-cols-12 md:gap-14" data-reveal>
              <div class:list={['md:col-span-7', invertido && 'md:order-2']}>
                <Mockup
                  url={projeto.url}
                  src={projeto.imagemDesktop}
                  alt={`Site do ${projeto.nome} em desktop`}
                />
              </div>

              <div class:list={['md:col-span-5', invertido && 'md:order-1']}>
                <p class="mono-label">
                  <span class="text-muted">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mx-2 text-line">/</span>
                  {projeto.estilo}
                </p>

                <h3 class="mt-4 text-2xl md:text-3xl">{projeto.nome}</h3>

                <p class="mt-3 text-[15px] leading-relaxed text-muted">
                  {projeto.contexto}
                </p>

                <dl class="mt-7 space-y-6 border-t border-line pt-7">
                  <div>
                    <dt class="mono-label">Problema</dt>
                    <dd class="mt-2.5 text-[15px] leading-relaxed">
                      {projeto.problema}
                    </dd>
                  </div>

                  <div>
                    <dt class="mono-label">Solução</dt>
                    <dd class="mt-2.5">
                      <ul class="space-y-2.5">
                        {projeto.solucao.map((item) => (
                          <li class="flex gap-3 text-[15px] leading-snug">
                            <span
                              class="mt-[10px] h-px w-3 shrink-0 bg-accent"
                              aria-hidden="true"
                            />
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </dd>
                  </div>

                  {projeto.resultado && (
                    <div>
                      <dt class="mono-label">Resultado</dt>
                      <dd class="mt-2.5 text-[15px] leading-relaxed">
                        {projeto.resultado}
                      </dd>
                    </div>
                  )}
                </dl>

                <a
                  class="link-arrow mt-8"
                  href={projeto.url}
                  target="_blank"
                  rel="noopener"
                >
                  Ver projeto ao vivo
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>