---
import SectionTitle from "../ui/SectionTitle.astro";
import Button from "../ui/Button.astro";
import { site } from "../../data/site";
---
<section id="contato" class="contato">
  <SectionTitle
    eyebrow="Contato"
    title="Vamos conversar?"
    description="Aberto a oportunidades de estágio e posições júnior em backend / full-stack."
  />
  <div class="cards">
    <a class="contact-card" href={`mailto:${site.email}`}>
      <span class="label">E-mail</span>
      <span class="value">{site.email}</span>
    </a>
    <a class="contact-card" href={site.linkedin} target="_blank" rel="noopener noreferrer">
      <span class="label">LinkedIn</span>
      <span class="value">/in/menesesdouglas</span>
    </a>
    <a class="contact-card" href={site.github} target="_blank" rel="noopener noreferrer">
      <span class="label">GitHub</span>
      <span class="value">@menesesdouglas</span>
    </a>
  </div>
  <div class="cta">
    <Button href={`mailto:${site.email}`}>Enviar e-mail</Button>
    <Button href={site.linkedin} variant="ghost" external>Conectar no LinkedIn</Button>
  </div>
  <p class="local">{site.localizacao}</p>
</section>

<style>
  .contato { padding: var(--space-12) 0 var(--space-8); }
  .cards {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
    margin-bottom: var(--space-8);
  }
  @media (min-width: 640px) {
    .cards { grid-template-columns: repeat(3, 1fr); }
  }
  .contact-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--transition), transform var(--transition);
  }
  .contact-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
  .value {
    font-size: 0.9375rem;
    color: var(--color-text);
    word-break: break-all;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .local {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
</style>