---
import Badge from "../ui/Badge.astro";
import SectionTitle from "../ui/SectionTitle.astro";

const tecnologias = [
  "Python", "Java", "FastAPI", "Spring Boot", "React",
  "PostgreSQL", "SQLite", "SQL Server", "Git", "GitHub",
  "JWT", "SQLAlchemy", "Alembic", "Docker",
];
---
<section id="stack" class="stack-section">
  <SectionTitle
    eyebrow="Ferramentas"
    title="Stack de desenvolvimento"
    description="Tecnologias que uso em projetos reais e estudos contínuos."
  />
  <ul class="stack-grid">
    {tecnologias.map((t) => <li><Badge label={t} /></li>)}
  </ul>
</section>

<style>
  .stack-section { padding: 3rem 0; }
  .stack-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>