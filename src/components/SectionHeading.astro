---
interface Props {
  numero: string;
  titulo: string;
  descricao?: string;
}

const { numero, titulo, descricao } = Astro.props;
---

<div
  class="flex flex-col gap-4 border-t border-line pt-6 md:flex-row md:items-baseline md:justify-between md:gap-12"
  data-reveal
>
  <p class="mono-label">
    <span class="text-muted">{numero}</span>
    <span class="mx-2 text-line">/</span>
    <span class="text-ink">{titulo}</span>
  </p>

  {descricao && (
    <p class="max-w-md text-[15px] text-muted md:text-right">{descricao}</p>
  )}
</div>